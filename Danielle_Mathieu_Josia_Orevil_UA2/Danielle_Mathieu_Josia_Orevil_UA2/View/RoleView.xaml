<UserControl x:Class="Danielle_Mathieu_Josia_Orevil_UA2.View.RoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Danielle_Mathieu_Josia_Orevil_UA2.View"
             xmlns:vm="clr-namespace:Danielle_Mathieu_Josia_Orevil_UA2.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:RoleViewModel/>
    </UserControl.DataContext>

    <Grid>
        <StackPanel HorizontalAlignment="Center" Width="350">

            <TextBlock Text="Gestion des Roles"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Nom Role:" />
            <TextBox Text="{Binding SelectedRole.NomRole, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Description :" />
            <TextBox Text="{Binding SelectedRole.Description, UpdateSourceTrigger=PropertyChanged}" />

            <ListBox ItemsSource="{Binding Roles}"
                     SelectedItem="{Binding SelectedRole}"
                     DisplayMemberPath="NomRole"
                     Height="100"
                     Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
             <Button Command="{Binding AddRoleCommand}" Content="Ajouter" Width="100" Margin="5,0"/>
                <!--  <Button Command="{Binding UpdateRole}" Content="Modifier" Width="100" Margin="5,0"/>
                <Button Command="{Binding DeleteRole}" Content="Supprimer" Width="100" Margin="5,0"/>-->
            </StackPanel>

        </StackPanel>
    </Grid>

</UserControl>
