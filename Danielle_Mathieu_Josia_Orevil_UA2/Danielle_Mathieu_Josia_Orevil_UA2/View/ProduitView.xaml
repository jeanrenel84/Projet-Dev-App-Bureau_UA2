<UserControl x:Class="Danielle_Mathieu_Josia_Orevil_UA2.View.ProduitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Danielle_Mathieu_Josia_Orevil_UA2.View"
               xmlns:vm="clr-namespace:Danielle_Mathieu_Josia_Orevil_UA2.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:ProduitViewModel/>
    </UserControl.DataContext>
    <Grid Background="#E8F0FE">
        <StackPanel HorizontalAlignment="Center" Width="350">

            <TextBlock Text="Gestion des Produits"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

           

            <TextBlock Text="Nom du produit:" />
            <TextBox Text="{Binding SelectedProduit.NomProduit}" />

            <TextBlock Text="Description:" />
            <TextBox Text="{Binding SelectedProduit.Description}" />

            <TextBlock Text="Catégorie:" />
            <TextBox Text="{Binding SelectedProduit.Categorie}" />

            <TextBlock Text="Prix:" />
            <TextBox Text="{Binding SelectedProduit.Prix}" />

            <TextBlock Text="Quantité en stock:" />
            <TextBox Text="{Binding SelectedProduit.QuantiteStock}" />

            <CheckBox IsChecked="{Binding SelectedProduit.EstDisponible}"
                  Content="Disponible"
                  HorizontalAlignment="Center"/>
            <ListBox ItemsSource="{Binding Produits}"
                SelectedItem="{Binding SelectedProduit}"
                    DisplayMemberPath="NomProduit"
                    Height="100"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding AddProduitCommand}" Content="Ajouter" Width="100"/>
                <Button Command="{Binding UpdateProduitCommand}" Content="Modifier" Width="100"/>
                <Button Command="{Binding DeleteProduitCommand}" Content="Supprimer" Width="100"/>
            </StackPanel>

           
            
        </StackPanel>
    </Grid>

</UserControl>
